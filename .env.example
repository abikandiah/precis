# precis generation module — environment configuration.
# Copy to .env and fill in real values: `cp .env.example .env`
# .env itself is gitignored — never commit real credentials.

# --- Required ---

# LLM gateway: OpenRouter-style (base URL + key + model via env vars, not
# a vendor-specific SDK — any OpenAI-compatible gateway works, not just
# OpenRouter itself). https://openrouter.ai/keys
PRECIS_LLM_API_KEY=

# Model id in your gateway's catalog, e.g. "anthropic/claude-sonnet-4.5" or
# "openai/gpt-5" — whatever your account has access to.
PRECIS_LLM_MODEL=

# Search grounding (Tavily). https://tavily.com
PRECIS_SEARCH_API_KEY=

# --- Optional — shown with their defaults; uncomment to override ---

# Only needed if not using OpenRouter itself.
# PRECIS_LLM_BASE_URL=https://openrouter.ai/api/v1

# Retries for transient failures (rate limits, 5xx) at the LLM-client level.
# PRECIS_LLM_MAX_RETRIES=5

# Stage 2's per-chapter fan-out concurrency.
# PRECIS_CONCURRENCY=3

# Circuit breakers, not constraints meant to bind on a normal run — see
# docs/blueprint.md's Run budget section.
# PRECIS_RUN_BUDGET_SECONDS=3600
# PRECIS_LLM_CALL_TIMEOUT_SECONDS=120

# Checkpoint DB path. The Docker image already sets this to
# /data/checkpoints.sqlite (mount a volume at /data — see README.md) so
# resume survives container restarts. Only override for a local/non-Docker
# run, where it defaults to .precis/checkpoints.sqlite relative to cwd.
# PRECIS_CHECKPOINT_DB_PATH=/data/checkpoints.sqlite
