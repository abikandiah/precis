# precis generation module — environment configuration.
# Copy to .env and fill in real values: `cp .env.example .env`
# .env itself is gitignored — never commit real credentials.

# --- Required ---

# LLM gateway: OpenRouter-style (base URL + key + model via env vars, not
# a vendor-specific SDK — any OpenAI-compatible gateway works, not just
# OpenRouter itself). https://openrouter.ai/keys
PRECIS_LLM_API_KEY=

# Model id in your gateway's catalog — a paid model; precis uses
# "anthropic/claude-haiku-4.5" (docs/v2-plan.md).
PRECIS_LLM_MODEL=

# Search grounding (Tavily). https://tavily.com
PRECIS_SEARCH_API_KEY=

# --- Optional — shown with their defaults; uncomment to override ---

# Only needed if not using OpenRouter itself.
# PRECIS_LLM_BASE_URL=https://openrouter.ai/api/v1

# Retries for transient failures (rate limits, 5xx) at the LLM-client level.
# PRECIS_LLM_MAX_RETRIES=5

# Timeout for one LLM call — a circuit breaker for a hung call. The write
# call sets its own, longer one.
# PRECIS_LLM_CALL_TIMEOUT_SECONDS=120

# Research cache: each book's raw search results, so a rerun doesn't search
# again (--fresh refetches). The Docker image sets this to /data/cache; for a
# local run it defaults to .precis/cache relative to cwd.
# PRECIS_CACHE_DIR=/data/cache
